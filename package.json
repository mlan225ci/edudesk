{
  "name": "edudesk",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "db:up": "node scripts/postgres.mjs",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:demo": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs prisma/demo-erp.ts",
    "db:procedures": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs prisma/synchroniser-procedures.ts",
    "prod": "node scripts/prod.mjs",
    "prod:demarrer": "node scripts/prod.mjs --sans-build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.4",
    "nodemailer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "embedded-postgres": "^18.1.0-beta.16",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
