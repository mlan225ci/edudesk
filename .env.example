DATABASE_URL="postgresql://edudesk:edudesk@127.0.0.1:5432/edudesk?schema=public"
AUTH_SECRET="change-me"
CRON_SECRET="change-me"
SMS_SENDER="EDUDESK"
# Laisser vide pour garder les SMS dans le journal, sans operateur.
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
# Adresse publique du site, utilisee dans le lien de suivi envoye aux clients. Exemple : https://suivi.edudesk.ci
URL_PUBLIQUE=""
# Serveur e-mail (aussi reglable dans Parametres > E-mail). Laisser vide pour garder les e-mails dans le journal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Mettre 0 pour couper le planificateur integre (alertes J-1 et retards).
EDUDESK_PLANIFICATEUR="1"
